---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

  <!-- Header -->
  <header class="header">
    <img src="/public/assets/Logo.png" alt="Nilima’s Food Products" />
    <span class="since">Since 2013</span>
  </header>

  <!-- Hero Section -->
  <section class="hero">

	<!-- Pricing Section -->
<section class="pricing">

  <div class="pricing-head">
    <h2>Our Products</h2>
    <p class="pricing-sub">
      Freshly prepared · Traditional recipes · Home delivery
    </p>
  </div>

  <div class="pricing-grid">

    <!-- Shankarpali -->
    <div class="price-card">
      <img src="/public/assets/shankarpali.png" alt="Shankarpali" />

      <h3>Shankarpali</h3>
      <p class="desc">Crisp, mildly sweet, homemade</p>

      <div class="price">
        ₹460 <span>/ kg</span>
      </div>

      <a
        href="https://wa.me/918805794750?text=I want to order Shankarpali"
        class="price-cta"
        target="_blank"
      >
        Order on WhatsApp
      </a>
    </div>

    <!-- Bhajani Chakali -->
    <div class="price-card featured">
      <img src="/assets/chakali.png" alt="Bhajani Chakali" />

      <h3>Bhajani Chakali</h3>
      <p class="desc">Spicy, crunchy, pure bhajani</p>

      <div class="price">
        ₹560 <span>/ kg</span>
      </div>

      <a
        href="https://wa.me/918805794750?text=I want to order Bhajani Chakali"
        class="price-cta"
        target="_blank"
      >
        Order on WhatsApp
      </a>
    </div>

  </div>

</section>


    <!-- Left: Copy -->
    <div class="hero-copy">

      <span class="eyebrow">Authentic Maharashtrian Snacks</span>

      <h1>
        Tradition,<br />
        made <span>relevant</span> for today
      </h1>

      <p class="marathi">
        घरगुती पद्धतीने बनवलेले खमंग पदार्थ
      </p>

      <p class="desc">
        Bhajani Chakali & Shankarpali made in small batches,
        using pure ghee, Gemini sunflower oil and zero palm oil.
      </p>

<!-- Core Values with Icons -->
<section class="core-values">

  <div class="core-item">
    <img src="/public/assets/icons/palm-oil-free.png" alt="No Palm Oil" />
    <h4>No Palm Oil</h4>
    <p>Clean, conscious oils only</p>
  </div>

  <div class="core-item">
    <img src="/public/assets/icons/GeminiOil.jpg" alt="Gemini Sunflower Oil" />
    <h4>Gemini Oil</h4>
    <p>Light · stable · trusted</p>
  </div>

  <div class="core-item">
    <img src="/assets/icons/ghee.png" alt="Gowardhan Pure Ghee" />
    <h4>Pure Ghee</h4>
    <p>For Shankarpali only</p>
  </div>

  <div class="core-item">
    <img src="/assets/icons/homemade.jpg" alt="Homemade" />
    <h4>Homemade</h4>
    <p>Small-batch prepared</p>
  </div>

</section>



      <!-- CTA -->
      <a
        href="https://wa.me/918805794750"
        target="_blank"
        class="cta"
      >
        Order on WhatsApp
      </a>

    </div>

    <!-- Right: Image -->
    <div class="hero-media">
      <img
        src="public/assets/chakali.png"
        alt="Bhajani Chakali"
      />
    </div>

  </section>

</BaseLayout>
